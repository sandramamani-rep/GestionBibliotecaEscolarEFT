<?xml version='1.0' encoding='UTF-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VistaReportes">
  <grid id="r001" binding="jpReportes" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="0" left="0" bottom="0" right="0" />
    <constraints>
      <xy x="20" y="20" width="800" height="500" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="r002" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Reporte:" />
        </properties>
      </component>
      <component id="r003" class="javax.swing.JComboBox" binding="cmbReporte">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <component id="r004" class="javax.swing.JButton" binding="btnConsultar">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Consultar" />
        </properties>
      </component>
      <component id="r005" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Estudiante:" />
        </properties>
      </component>
      <component id="r006" class="javax.swing.JComboBox" binding="cmbEstudiante">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <component id="r007" class="javax.swing.JButton" binding="btnActualizarEstudiantes">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Actualizar estudiantes" />
        </properties>
      </component>
      <scrollpane id="r008">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="r009" class="javax.swing.JTable" binding="tabla">
            <constraints />
            <properties />
          </component>
        </children>
      </scrollpane>
      <component id="r010" class="javax.swing.JLabel" binding="lblResultado">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Selecciona un reporte y pulsa Consultar." />
        </properties>
      </component>
    </children>
  </grid>
</form>